{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "entryFile": "app/services/core/main",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "infrastructure/gateways/llm-provider/system_prompt.txt",
        "outDir": "dist"
      }
    ],
    "watchAssets": true
  }
}
